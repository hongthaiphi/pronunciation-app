{
  "sentences": [
    { "id": 1,  "text": "Hello, how are you today?",                                          "level": "A1", "category": "greeting",      "focus": [], "image": "https://source.unsplash.com/800x500/?smile,wave,greeting" },
    { "id": 2,  "text": "My name is John and I live in Vietnam.",                              "level": "A1", "category": "introduction",  "focus": [], "image": "https://source.unsplash.com/800x500/?handshake,meeting,hello" },
    { "id": 3,  "text": "I like apples, oranges, and bananas.",                                "level": "A1", "category": "food",          "focus": [], "image": "https://source.unsplash.com/800x500/?fruit,apples,colorful" },
    { "id": 4,  "text": "What time is it now?",                                                "level": "A1", "category": "daily",         "focus": [], "image": "https://source.unsplash.com/800x500/?clock,time,watch" },
    { "id": 5,  "text": "I go to school every day.",                                           "level": "A1", "category": "daily",         "focus": [], "image": "https://source.unsplash.com/800x500/?school,bus,morning" },
    { "id": 6,  "text": "She has a cat and a dog.",                                            "level": "A1", "category": "daily",         "focus": [], "image": "https://source.unsplash.com/800x500/?cat,dog,pets" },
    { "id": 7,  "text": "We eat breakfast in the morning.",                                    "level": "A1", "category": "food",          "focus": [], "image": "https://source.unsplash.com/800x500/?breakfast,morning,food" },
    { "id": 8,  "text": "How old are you?",                                                    "level": "A1", "category": "greeting",      "focus": [], "image": "https://source.unsplash.com/800x500/?birthday,candles,cake" },
    { "id": 9,  "text": "Nice to meet you.",                                                   "level": "A1", "category": "greeting",      "focus": [], "image": "https://source.unsplash.com/800x500/?smile,meet,friendly" },
    { "id": 10, "text": "I am happy today.",                                                   "level": "A1", "category": "feeling",       "focus": [], "image": "https://source.unsplash.com/800x500/?happy,smile,joy" },

    { "id": 11, "text": "The weather is beautiful today.",                                     "level": "A2", "category": "weather",       "focus": [], "image": "https://source.unsplash.com/800x500/?sunny,sky,beautiful" },
    { "id": 12, "text": "Could you please repeat that for me?",                               "level": "A2", "category": "request",       "focus": [], "image": "https://source.unsplash.com/800x500/?conversation,talking,people" },
    { "id": 13, "text": "I usually wake up at seven in the morning.",                         "level": "A2", "category": "daily",         "focus": [], "image": "https://source.unsplash.com/800x500/?morning,alarm,sunrise" },
    { "id": 14, "text": "Can you help me find the nearest station?",                          "level": "A2", "category": "travel",        "focus": [], "image": "https://source.unsplash.com/800x500/?subway,station,train" },
    { "id": 15, "text": "I would like a cup of coffee, please.",                              "level": "A2", "category": "food",          "focus": [], "image": "https://source.unsplash.com/800x500/?coffee,cafe,cup" },
    { "id": 16, "text": "She works at a hospital as a nurse.",                                "level": "A2", "category": "work",          "focus": [], "image": "https://source.unsplash.com/800x500/?hospital,nurse,medical" },
    { "id": 17, "text": "We visited the museum last weekend.",                                "level": "A2", "category": "travel",        "focus": [], "image": "https://source.unsplash.com/800x500/?museum,art,gallery" },
    { "id": 18, "text": "I enjoy reading books and watching movies.",                         "level": "A2", "category": "hobby",         "focus": [], "image": "https://source.unsplash.com/800x500/?books,reading,cinema" },
    { "id": 19, "text": "There are thirty students in my class.",                             "level": "A2", "category": "school",        "focus": ["θ"], "image": "https://source.unsplash.com/800x500/?classroom,students,group" },
    { "id": 20, "text": "The children played in the park all afternoon.",                     "level": "A2", "category": "daily",         "focus": [], "image": "https://source.unsplash.com/800x500/?park,children,playing" },

    { "id": 21, "text": "I think that pronunciation is important for communication.",         "level": "B1", "category": "opinion",       "focus": ["θ"], "image": "https://source.unsplash.com/800x500/?speaking,language,communication" },
    { "id": 22, "text": "Although it was raining, we decided to go for a walk.",             "level": "B1", "category": "weather",       "focus": [], "image": "https://source.unsplash.com/800x500/?rain,walk,umbrella" },
    { "id": 23, "text": "She suggested that we should try a different approach.",            "level": "B1", "category": "work",          "focus": ["ʃ"], "image": "https://source.unsplash.com/800x500/?team,meeting,discussion" },
    { "id": 24, "text": "Learning a new language takes a lot of patience and practice.",     "level": "B1", "category": "school",        "focus": [], "image": "https://source.unsplash.com/800x500/?language,learning,study" },
    { "id": 25, "text": "The presentation was well-organized and very informative.",          "level": "B1", "category": "work",          "focus": [], "image": "https://source.unsplash.com/800x500/?presentation,projector,office" },
    { "id": 26, "text": "He realized that he had left his wallet at home.",                  "level": "B1", "category": "daily",         "focus": [], "image": "https://source.unsplash.com/800x500/?wallet,pocket,lost" },
    { "id": 27, "text": "I would rather stay home than go out in this weather.",             "level": "B1", "category": "opinion",       "focus": ["ð"], "image": "https://source.unsplash.com/800x500/?home,cozy,indoor" },
    { "id": 28, "text": "The teacher explained the concept clearly with examples.",           "level": "B1", "category": "school",        "focus": [], "image": "https://source.unsplash.com/800x500/?teacher,classroom,explain" },
    { "id": 29, "text": "They have been working on this project for three months.",          "level": "B1", "category": "work",          "focus": ["θ"], "image": "https://source.unsplash.com/800x500/?project,team,work" },
    { "id": 30, "text": "I wish I had started learning English much earlier.",               "level": "B1", "category": "feeling",       "focus": [], "image": "https://source.unsplash.com/800x500/?wish,dream,hope" },

    { "id": 31, "text": "I appreciate your patience and understanding.",                     "level": "B2", "category": "social",        "focus": [], "image": "https://source.unsplash.com/800x500/?gratitude,team,support" },
    { "id": 32, "text": "The research suggests a strong correlation between the two variables.", "level": "B2", "category": "academic",   "focus": [], "image": "https://source.unsplash.com/800x500/?research,data,science" },
    { "id": 33, "text": "Despite the challenges, the team managed to deliver on time.",      "level": "B2", "category": "work",          "focus": ["ð"], "image": "https://source.unsplash.com/800x500/?team,success,deadline" },
    { "id": 34, "text": "The government should invest more in renewable energy sources.",    "level": "B2", "category": "social",        "focus": [], "image": "https://source.unsplash.com/800x500/?solar,energy,renewable" },
    { "id": 35, "text": "She thoroughly enjoyed the thought-provoking documentary.",        "level": "B2", "category": "hobby",         "focus": ["θ", "ð"], "image": "https://source.unsplash.com/800x500/?documentary,film,cinema" },
    { "id": 36, "text": "It is worth considering whether this approach is sustainable.",    "level": "B2", "category": "opinion",       "focus": ["θ", "ð"], "image": "https://source.unsplash.com/800x500/?sustainability,earth,green" },
    { "id": 37, "text": "The weather forecast predicted heavy rainfall throughout the week.", "level": "B2", "category": "weather",      "focus": ["θ", "ð"], "image": "https://source.unsplash.com/800x500/?rain,storm,forecast" },
    { "id": 38, "text": "He expressed his frustration with the current situation calmly.",  "level": "B2", "category": "feeling",       "focus": [], "image": "https://source.unsplash.com/800x500/?calm,emotion,person" },
    { "id": 39, "text": "They eventually reached a compromise after lengthy negotiations.", "level": "B2", "category": "work",          "focus": [], "image": "https://source.unsplash.com/800x500/?negotiation,handshake,deal" },
    { "id": 40, "text": "The exhibition showcased works from artists around the world.",    "level": "B2", "category": "culture",       "focus": [], "image": "https://source.unsplash.com/800x500/?art,gallery,exhibition" },

    { "id": 41, "text": "The third thing, therefore, requires careful consideration.",      "level": "C1", "category": "formal",        "focus": ["θ", "ð"], "image": "https://source.unsplash.com/800x500/?formal,speech,consideration" },
    { "id": 42, "text": "The ambiguity of the clause rendered the contract unenforceable.", "level": "C1", "category": "academic",      "focus": [], "image": "https://source.unsplash.com/800x500/?contract,law,document" },
    { "id": 43, "text": "Whether or not the hypothesis holds remains to be thoroughly tested.", "level": "C1", "category": "academic", "focus": ["θ", "ð"], "image": "https://source.unsplash.com/800x500/?laboratory,science,experiment" },
    { "id": 44, "text": "The socioeconomic implications of this policy are far-reaching.",  "level": "C1", "category": "social",        "focus": [], "image": "https://source.unsplash.com/800x500/?policy,government,economics" },
    { "id": 45, "text": "She articulated her thoughts with remarkable clarity and precision.", "level": "C1", "category": "formal",    "focus": [], "image": "https://source.unsplash.com/800x500/?speech,microphone,audience" },
    { "id": 46, "text": "The paradigm shift in thinking has transformed the entire field.", "level": "C1", "category": "academic",     "focus": ["θ"], "image": "https://source.unsplash.com/800x500/?mind,thinking,innovation" },
    { "id": 47, "text": "Notwithstanding the difficulties, they persevered through every challenge.", "level": "C1", "category": "formal", "focus": ["θ", "ð"], "image": "https://source.unsplash.com/800x500/?perseverance,challenge,success" },
    { "id": 48, "text": "The author's nuanced portrayal of grief resonated deeply with readers.", "level": "C1", "category": "culture", "focus": [], "image": "https://source.unsplash.com/800x500/?book,author,reading" },
    { "id": 49, "text": "Ethical considerations should underpin all scientific research.",  "level": "C1", "category": "academic",     "focus": ["θ"], "image": "https://source.unsplash.com/800x500/?ethics,research,science" },
    { "id": 50, "text": "Their thorough analysis of the data thoroughly undermined the theory.", "level": "C1", "category": "academic", "focus": ["θ", "ð"], "image": "https://source.unsplash.com/800x500/?data,analysis,graph" },

    { "id": 51, "text": "This is a red ball.",                                               "level": "A1", "category": "daily",         "focus": [], "image": "https://source.unsplash.com/800x500/?ball,red,toy" },
