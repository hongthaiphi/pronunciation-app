{
  "sentences": [
    { "id": 1,  "text": "Hello, how are you today?",                                          "level": "A1", "category": "greeting",      "focus": [], "image": "https://picsum.photos/seed/greeting/800/400" },
    { "id": 2,  "text": "My name is John and I live in Vietnam.",                              "level": "A1", "category": "introduction",  "focus": [], "image": "https://picsum.photos/seed/meeting/800/400" },
    { "id": 3,  "text": "I like apples, oranges, and bananas.",                                "level": "A1", "category": "food",          "focus": [], "image": "https://picsum.photos/seed/fruits/800/400" },
    { "id": 4,  "text": "What time is it now?",                                                "level": "A1", "category": "daily",         "focus": [], "image": "https://picsum.photos/seed/clockwatch/800/400" },
    { "id": 5,  "text": "I go to school every day.",                                           "level": "A1", "category": "daily",         "focus": [], "image": "https://picsum.photos/seed/schoolbus/800/400" },
    { "id": 6,  "text": "She has a cat and a dog.",                                            "level": "A1", "category": "daily",         "focus": [], "image": "https://picsum.photos/seed/catdog/800/400" },
    { "id": 7,  "text": "We eat breakfast in the morning.",                                    "level": "A1", "category": "food",          "focus": [], "image": "https://picsum.photos/seed/breakfast/800/400" },
    { "id": 8,  "text": "How old are you?",                                                    "level": "A1", "category": "greeting",      "focus": [], "image": "https://picsum.photos/seed/birthday/800/400" },
    { "id": 9,  "text": "Nice to meet you.",                                                   "level": "A1", "category": "greeting",      "focus": [], "image": "https://picsum.photos/seed/smiling/800/400" },
    { "id": 10, "text": "I am happy today.",                                                   "level": "A1", "category": "feeling",       "focus": [], "image": "https://picsum.photos/seed/happiness/800/400" },

    { "id": 11, "text": "The weather is beautiful today.",                                     "level": "A2", "category": "weather",       "focus": [], "image": "https://picsum.photos/seed/sunshine/800/400" },
    { "id": 12, "text": "Could you please repeat that for me?",                               "level": "A2", "category": "request",       "focus": [], "image": "https://picsum.photos/seed/talking/800/400" },
    { "id": 13, "text": "I usually wake up at seven in the morning.",                         "level": "A2", "category": "daily",         "focus": [], "image": "https://picsum.photos/seed/sunrise/800/400" },
    { "id": 14, "text": "Can you help me find the nearest station?",                          "level": "A2", "category": "travel",        "focus": [], "image": "https://picsum.photos/seed/trainstation/800/400" },
    { "id": 15, "text": "I would like a cup of coffee, please.",                              "level": "A2", "category": "food",          "focus": [], "image": "https://picsum.photos/seed/coffeecup/800/400" },
    { "id": 16, "text": "She works at a hospital as a nurse.",                                "level": "A2", "category": "work",          "focus": [], "image": "https://picsum.photos/seed/hospital/800/400" },
    { "id": 17, "text": "We visited the museum last weekend.",                                "level": "A2", "category": "travel",        "focus": [], "image": "https://picsum.photos/seed/museum/800/400" },
    { "id": 18, "text": "I enjoy reading books and watching movies.",                         "level": "A2", "category": "hobby",         "focus": [], "image": "https://picsum.photos/seed/readingbook/800/400" },
    { "id": 19, "text": "There are thirty students in my class.",                             "level": "A2", "category": "school",        "focus": ["θ"], "image": "https://picsum.photos/seed/students/800/400" },
    { "id": 20, "text": "The children played in the park all afternoon.",                     "level": "A2", "category": "daily",         "focus": [], "image": "https://picsum.photos/seed/parkplay/800/400" },

    { "id": 21, "text": "I think that pronunciation is important for communication.",         "level": "B1", "category": "opinion",       "focus": ["θ"], "image": "https://picsum.photos/seed/language/800/400" },
    { "id": 22, "text": "Although it was raining, we decided to go for a walk.",             "level": "B1", "category": "weather",       "focus": [], "image": "https://picsum.photos/seed/rainwalk/800/400" },
    { "id": 23, "text": "She suggested that we should try a different approach.",            "level": "B1", "category": "work",          "focus": ["ʃ"], "image": "https://picsum.photos/seed/teamwork/800/400" },
    { "id": 24, "text": "Learning a new language takes a lot of patience and practice.",     "level": "B1", "category": "school",        "focus": [], "image": "https://picsum.photos/seed/practice/800/400" },
    { "id": 25, "text": "The presentation was well-organized and very informative.",          "level": "B1", "category": "work",          "focus": [], "image": "https://picsum.photos/seed/presentation/800/400" },
    { "id": 26, "text": "He realized that he had left his wallet at home.",                  "level": "B1", "category": "daily",         "focus": [], "image": "https://picsum.photos/seed/wallet/800/400" },
    { "id": 27, "text": "I would rather stay home than go out in this weather.",             "level": "B1", "category": "opinion",       "focus": ["ð"], "image": "https://picsum.photos/seed/cozy/800/400" },
    { "id": 28, "text": "The teacher explained the concept clearly with examples.",           "level": "B1", "category": "school",        "focus": [], "image": "https://picsum.photos/seed/teaching/800/400" },
    { "id": 29, "text": "They have been working on this project for three months.",          "level": "B1", "category": "work",          "focus": ["θ"], "image": "https://picsum.photos/seed/projectwork/800/400" },
    { "id": 30, "text": "I wish I had started learning English much earlier.",               "level": "B1", "category": "feeling",       "focus": [], "image": "https://picsum.photos/seed/dreaming/800/400" },

    { "id": 31, "text": "I appreciate your patience and understanding.",                     "level": "B2", "category": "social",        "focus": [], "image": "https://picsum.photos/seed/gratitude/800/400" },
    { "id": 32, "text": "The research suggests a strong correlation between the two variables.", "level": "B2", "category": "academic",   "focus": [], "image": "https://picsum.photos/seed/research/800/400" },
    { "id": 33, "text": "Despite the challenges, the team managed to deliver on time.",      "level": "B2", "category": "work",          "focus": ["ð"], "image": "https://picsum.photos/seed/deadline/800/400" },
    { "id": 34, "text": "The government should invest more in renewable energy sources.",    "level": "B2", "category": "social",        "focus": [], "image": "https://picsum.photos/seed/solar/800/400" },
    { "id": 35, "text": "She thoroughly enjoyed the thought-provoking documentary.",        "level": "B2", "category": "hobby",         "focus": ["θ", "ð"], "image": "https://picsum.photos/seed/cinema/800/400" },
    { "id": 36, "text": "It is worth considering whether this approach is sustainable.",    "level": "B2", "category": "opinion",       "focus": ["θ", "ð"], "image": "https://picsum.photos/seed/sustainable/800/400" },
    { "id": 37, "text": "The weather forecast predicted heavy rainfall throughout the week.", "level": "B2", "category": "weather",      "focus": ["θ", "ð"], "image": "https://picsum.photos/seed/stormrain/800/400" },
    { "id": 38, "text": "He expressed his frustration with the current situation calmly.",  "level": "B2", "category": "feeling",       "focus": [], "image": "https://picsum.photos/seed/calmness/800/400" },
    { "id": 39, "text": "They eventually reached a compromise after lengthy negotiations.", "level": "B2", "category": "work",          "focus": [], "image": "https://picsum.photos/seed/negotiation/800/400" },
    { "id": 40, "text": "The exhibition showcased works from artists around the world.",    "level": "B2", "category": "culture",       "focus": [], "image": "https://picsum.photos/seed/artgallery/800/400" },

    { "id": 41, "text": "The third thing, therefore, requires careful consideration.",      "level": "C1", "category": "formal",        "focus": ["θ", "ð"], "image": "https://picsum.photos/seed/formal/800/400" },
    { "id": 42, "text": "The ambiguity of the clause rendered the contract unenforceable.", "level": "C1", "category": "academic",      "focus": [], "image": "https://picsum.photos/seed/lawdoc/800/400" },
    { "id": 43, "text": "Whether or not the hypothesis holds remains to be thoroughly tested.", "level": "C1", "category": "academic", "focus": ["θ", "ð"], "image": "https://picsum.photos/seed/laboratory/800/400" },
    { "id": 44, "text": "The socioeconomic implications of this policy are far-reaching.",  "level": "C1", "category": "social",        "focus": [], "image": "https://picsum.photos/seed/policy/800/400" },
    { "id": 45, "text": "She articulated her thoughts with remarkable clarity and precision.", "level": "C1", "category": "formal",    "focus": [], "image": "https://picsum.photos/seed/microphone/800/400" },
    { "id": 46, "text": "The paradigm shift in thinking has transformed the entire field.", "level": "C1", "category": "academic",     "focus": ["θ"], "image": "https://picsum.photos/seed/mindshift/800/400" },
    { "id": 47, "text": "Notwithstanding the difficulties, they persevered through every challenge.", "level": "C1", "category": "formal", "focus": ["θ", "ð"], "image": "https://picsum.photos/seed/mountain/800/400" },
    { "id": 48, "text": "The author's nuanced portrayal of grief resonated deeply with readers.", "level": "C1", "category": "culture", "focus": [], "image": "https://picsum.photos/seed/authorbook/800/400" },
    { "id": 49, "text": "Ethical considerations should underpin all scientific research.",  "level": "C1", "category": "academic",     "focus": ["θ"], "image": "https://picsum.photos/seed/ethics/800/400" },
    { "id": 50, "text": "Their thorough analysis of the data thoroughly undermined the theory.", "level": "C1", "category": "academic", "focus": ["θ", "ð"], "image": "https://picsum.photos/seed/dataanalysis/800/400" },

    { "id": 51, "text": "This is a red ball.",                                               "level": "A1", "category": "daily",         "focus": [], "image": "https://picsum.photos/seed/redball/800/400" },
    { "id": 52, "text": "I want to drink some water.",                                       "level": "A1", "category": "daily",         "focus": [], "image": "https://picsum.photos/seed/waterdrink/800/400" },
    { "id": 53, "text": "It is very hot outside.",                                           "level": "A1", "category": "weather",       "focus": [], "image": "https://picsum.photos/seed/summerhot/800/400" },
    { "id": 54, "text": "Please open the window.",                                           "level": "A2", "category": "request",       "focus": [], "image": "https://picsum.photos/seed/windowlight/800/400" },
    { "id": 55, "text": "I have never been to London before.",                               "level": "A2", "category": "travel",        "focus": [], "image": "https://picsum.photos/seed/london/800/400" },
    { "id": 56, "text": "The bus leaves at half past eight.",                                "level": "A2", "category": "travel",        "focus": [], "image": "https://picsum.photos/seed/citybus/800/400" },
    { "id": 57, "text": "If I were rich, I would travel the world.",                        "level": "B1", "category": "opinion",       "focus": [], "image": "https://picsum.photos/seed/worldtravel/800/400" },
    { "id": 58, "text": "She has been studying medicine for six years.",                    "level": "B1", "category": "school",        "focus": [], "image": "https://picsum.photos/seed/medschool/800/400" },
    { "id": 59, "text": "The results were neither conclusive nor particularly surprising.", "level": "B2", "category": "academic",     "focus": [], "image": "https://picsum.photos/seed/datascience/800/400" },
    { "id": 60, "text": "Theoretically speaking, the approach has both merits and drawbacks.", "level": "C1", "category": "academic",  "focus": ["θ"], "image": "https://picsum.photos/seed/university/800/400" }
  ]
